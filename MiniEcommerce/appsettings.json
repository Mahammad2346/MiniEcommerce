{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ProductGrpc": {
    "Address": "https://localhost:7008"
  },

  "ReverseProxy": {
    "Routes": {
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "basket-cluster": {
        "Destinations": {
          "basket-service": {
            "Address": "https://localhost:7143"
          }
        }
      }
    }
  }
}